# Copy to .env (never commit .env). One bridge = one database = one token.

# Bearer token the MCP client must present. MUST be >= 32 chars or the bridge
# rejects every /mcp call (fails closed). Generate: openssl rand -hex 32
MCP_BEARER_TOKEN=

# This bridge's OWN database (not shared with any other domain).
DATABASE_URL=postgresql://user:password@db:5432/yourdb

# Optional: port (default 3100) and the Postgres application_name shown in pg_stat_activity.
MCP_PORT=3100
APP_NAME=yourdomain-mcp-bridge

# Optional: only if you add a write tool that calls your app's own endpoint
# (like EOV's trigger_metrics_snapshot). Otherwise leave unset.
# APP_URL=http://app:3000
# CRON_SECRET=
